# Enforce LF everywhere. Windows contributors: set core.autocrlf=input.
* text=auto eol=lf

# Binary blobs — never line-ending-normalise these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.mp4  binary
*.mkv  binary
*.webm binary
*.pt   binary
*.pth  binary
*.onnx binary
*.engine binary
*.safetensors binary
*.npz  binary
*.npy  binary
*.parquet binary
